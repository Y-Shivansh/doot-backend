# Copy this file to .env and fill in real values. .env itself is never committed
# (see .gitignore) — this file is the template that IS committed, so anyone
# setting up the project knows what values are needed.

PORT=3000

# Neon's pooled connection string (has "-pooler" in the hostname) — used for
# normal app queries at runtime.
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# Neon's direct connection string (same as above, without "-pooler") — used
# only by Prisma CLI commands (migrations etc.), never by the running app.
DIRECT_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"
